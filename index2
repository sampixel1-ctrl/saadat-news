<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="UTF-8">

    <!-- جلوگیری از زوم در موبایل -->
    <meta name="viewport"
          content="width=device-width,
                   initial-scale=1.0,
                   maximum-scale=1.0,
                   minimum-scale=1.0,
                   user-scalable=no">

    <meta name="apple-mobile-web-app-capable" content="yes">

    <title>بازرگانی سعادت | تلگرام</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            overflow-x: hidden;

            /* جلوگیری از انتخاب و زوم ناخواسته */
            touch-action: manipulation;
            -webkit-text-size-adjust: 100%;
        }

        body {
            min-height: 100vh;
            min-height: 100dvh;

            font-family: Tahoma, Arial, sans-serif;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 18px;

            background:
                radial-gradient(
                    circle at 10% 10%,
                    rgba(205, 0, 88, 0.15),
                    transparent 30%
                ),
                radial-gradient(
                    circle at 90% 90%,
                    rgba(205, 0, 88, 0.12),
                    transparent 30%
                ),
                linear-gradient(
                    135deg,
                    #ffffff,
                    #eeeeee
                );
        }

        /* افکت های پس زمینه */
        .shape {
            position: fixed;
            z-index: 0;
            pointer-events: none;

            background: rgba(199, 0, 83, 0.08);

            border-radius: 50%;

            filter: blur(5px);
        }

        .shape-one {
            width: 260px;
            height: 260px;

            top: -120px;
            right: -100px;
        }

        .shape-two {
            width: 300px;
            height: 300px;

            bottom: -160px;
            left: -120px;
        }

        /* کارت اصلی */
        .container {
            position: relative;
            z-index: 2;

            width: 100%;
            max-width: 400px;

            padding: 34px 22px 25px;

            text-align: center;

            background: rgba(255, 255, 255, 0.55);

            border: 1px solid rgba(255,255,255,0.8);

            border-radius: 28px;

            backdrop-filter: blur(22px);
            -webkit-backdrop-filter: blur(22px);

            box-shadow:
                0 20px 50px rgba(0,0,0,0.12),
                inset 0 1px 1px rgba(255,255,255,0.9);
        }

        /* لوگو */
        .logo {
            width: 92px;
            height: 92px;

            margin: 0 auto 17px;

            border-radius: 26px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: linear-gradient(
                145deg,
                #d00059,
                #a90048
            );

            color: white;

            font-size: 50px;
            font-weight: bold;

            box-shadow:
                0 12px 28px rgba(190,0,80,0.28);
        }

        .line {
            width: 55px;
            height: 3px;

            margin: 0 auto 17px;

            border-radius: 10px;

            background: #c60055;
        }

        h1 {
            font-size: clamp(24px, 7vw, 29px);

            color: #222;

            margin-bottom: 10px;
        }

        .brand {
            color: #c60055;
        }

        .subtitle {
            color: #666;

            font-size: 14px;

            line-height: 2;

            margin-bottom: 23px;
        }

        /* بخش تلگرام */
        .telegram-box {
            padding: 20px 12px;

            margin-bottom: 17px;

            border-radius: 21px;

            background: rgba(255,255,255,0.58);

            border: 1px solid rgba(255,255,255,0.9);

            box-shadow:
                inset 0 1px 8px rgba(255,255,255,0.8);
        }

        /* آیکون تلگرام */
        .telegram-icon {
            width: 62px;
            height: 62px;

            margin: 0 auto 12px;

            border-radius: 50%;

            background: #229ED9;

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;

            font-size: 30px;

            box-shadow:
                0 9px 22px rgba(34,158,217,0.25);
        }

        .channel-title {
            font-size: 18px;

            font-weight: bold;

            color: #222;

            margin-bottom: 8px;
        }

        .channel-id {
            direction: ltr;

            color: #c60055;

            font-size: 14px;

            font-weight: bold;

            word-break: break-all;
        }

        /* دکمه */
        .telegram-button {
            width: 100%;

            min-height: 54px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 16px;

            text-decoration: none;

            color: white;

            font-size: 16px;

            font-weight: bold;

            background: linear-gradient(
                135deg,
                #d0005a,
                #ad0049
            );

            box-shadow:
                0 10px 24px rgba(190,0,80,0.28);

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .telegram-button:active {
            transform: scale(0.97);

            box-shadow:
                0 5px 12px rgba(190,0,80,0.20);
        }

        .footer {
            margin-top: 20px;

            color: #999;

            font-size: 11px;
        }

        /* گوشی های کوچک */
        @media (max-height: 700px) {

            body {
                padding: 12px;
            }

            .container {
                padding: 25px 20px 20px;
            }

            .logo {
                width: 75px;
                height: 75px;
                font-size: 42px;
                margin-bottom: 12px;
            }

            .subtitle {
                margin-bottom: 15px;
            }

            .telegram-box {
                padding: 15px 10px;
                margin-bottom: 13px;
            }

            .telegram-icon {
                width: 52px;
                height: 52px;
            }

            .footer {
                margin-top: 13px;
            }
        }
    </style>
</head>

<body>

    <div class="shape shape-one"></div>
    <div class="shape shape-two"></div>

    <main class="container">

        <div class="logo">
            S
        </div>

        <div class="line"></div>

        <h1>
            بازرگانی <span class="brand">سعادت</span>
        </h1>

        <p class="subtitle">
            کانال رسمی بازرگانی سعادت<br>
            جدیدترین اخبار و اطلاعات محصولات
        </p>

        <section class="telegram-box">

            <div class="telegram-icon">
                ➤
            </div>

            <div class="channel-title">
                کانال بازرگانی سعادت
            </div>

            <div class="channel-id">
                t.me/Saadatpakhsh1
            </div>

        </section>

        <a
            href="https://t.me/Saadatpakhsh1"
            class="telegram-button"
            target="_blank"
            rel="noopener noreferrer"
        >
            ورود به کانال تلگرام
        </a>

        <div class="footer">
            Saadat Trading Group
        </div>

    </main>

</body>
</html>
